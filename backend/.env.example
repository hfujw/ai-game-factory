# DeepSeek API Key（必填）
# 注册地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型选择
# deepseek-chat = V3（便宜，推荐日常使用）
# deepseek-reasoner = R1（推理更强，更贵）
DEEPSEEK_MODEL=deepseek-chat

# Tavily Search API（可选——不配也能用，LLM 会用自身知识兜底）
# 注册地址: https://tavily.com （免费 1000 次/月，国内可直连）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
